NODE_ENV=development
WEB_PORT=3000
API_PORT=3001
WEB_ORIGIN=http://localhost:3000
DATABASE_URL=postgresql://clivyra:clivyra@localhost:5432/clivyra?schema=public

# Optional seed overrides (no plaintext passwords)
# SEED_TENANT_SLUG=clivyra-demo
# SEED_TENANT_NAME=Clivyra Demo
# SEED_ADMIN_EMAIL=admin@clivyra.local
# SEED_ADMIN_NAME=Clivyra Admin
# SEED_ADMIN_PASSWORD_HASH=

# Auth (CLI-12) — replace secrets before any shared environment
AUTH_ACCESS_TOKEN_SECRET=change-me-access-token-secret-at-least-32-chars
AUTH_ACCESS_TOKEN_TTL_SECONDS=900
AUTH_REFRESH_TOKEN_TTL_SECONDS=604800
AUTH_PASSWORD_RESET_TTL_SECONDS=1800
AUTH_PASSWORD_PEPPER=change-me-password-pepper-at-least-32-chars
AUTH_SELF_SIGNUP_ENABLED=false
AUTH_EXPOSE_RESET_TOKEN=false
AUTH_COOKIE_DOMAIN=localhost
AUTH_COOKIE_SECURE=false
MAILER_DRIVER=noop
