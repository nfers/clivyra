# Copie o conteúdo para o GitHub Secret DEV_ENV_FILE (não commite valores reais).

NODE_ENV=production
COMPOSE_PROJECT_NAME=clivyra-dev

WEB_PORT=3000
API_PORT=3001
WEB_ORIGIN=https://dev.example.com
API_BASE_URL=https://api-dev.example.com

POSTGRES_DB=clivyra
POSTGRES_USER=clivyra
POSTGRES_PASSWORD=change-me-dev-strong-password

DATABASE_URL=postgresql://clivyra:change-me-dev-strong-password@db:5432/clivyra?schema=public

AUTH_ACCESS_TOKEN_SECRET=replace-with-long-random-secret
AUTH_PASSWORD_PEPPER=replace-with-long-random-pepper
AUTH_SELF_SIGNUP_ENABLED=false
AUTH_EXPOSE_RESET_TOKEN=false
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_DOMAIN=dev.example.com
AUDIT_IP_HASH_SALT=replace-with-random-salt
MAILER_DRIVER=smtp
SMTP_URL=https://smtp-bridge.example/send
