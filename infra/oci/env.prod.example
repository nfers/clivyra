# Copie o conteúdo para o GitHub Secret PROD_ENV_FILE (não commite valores reais).

NODE_ENV=production
COMPOSE_PROJECT_NAME=clivyra-prod

WEB_PORT=3000
API_PORT=3001
WEB_ORIGIN=https://app.example.com

POSTGRES_DB=clivyra
POSTGRES_USER=clivyra
POSTGRES_PASSWORD=change-me-prod-strong-password

DATABASE_URL=postgresql://clivyra:change-me-prod-strong-password@db:5432/clivyra?schema=public
