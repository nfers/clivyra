NODE_ENV=development
WEB_PORT=3000
API_PORT=3001
WEB_ORIGIN=http://127.0.0.1:3000
API_BASE_URL=http://127.0.0.1:3001
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:3001
DATABASE_URL=postgresql://clivyra:clivyra@127.0.0.1:5432/clivyra?schema=public

AUTH_ACCESS_TOKEN_SECRET=local-development-access-token-secret-change-me
AUTH_ACCESS_TOKEN_TTL_SECONDS=900
AUTH_REFRESH_TOKEN_TTL_SECONDS=604800
AUTH_PASSWORD_RESET_TTL_SECONDS=1800
AUTH_PASSWORD_PEPPER=local-development-password-pepper-change-me
AUTH_SELF_SIGNUP_ENABLED=false
AUTH_EXPOSE_RESET_TOKEN=false
# Intentionally unset: Domain=localhost breaks cookies on 127.0.0.1 (Playwright baseURL).
# AUTH_COOKIE_DOMAIN=
AUTH_COOKIE_SECURE=false
AUDIT_IP_HASH_SALT=local-dev-audit-ip-hash-salt
MAILER_DRIVER=noop
INVITATION_TTL_HOURS=72
FILE_STORAGE_DRIVER=local
FILE_STORAGE_LOCAL_DIR=.local-storage
FILE_STORAGE_SIGNING_SECRET=local-development-file-storage-signing-secret
API_PUBLIC_BASE_URL=http://127.0.0.1:3001

# Playwright fixtures (synthetic)
E2E_PASSWORD=E2eCorrectHorse1!
E2E_TENANT_SLUG=studio-a
E2E_TENANT_B_SLUG=studio-b
E2E_OWNER_EMAIL=owner@studio-a.test
E2E_OWNER_PASSWORD=E2eCorrectHorse1!
E2E_ADMIN_EMAIL=admin@studio-a.test
E2E_ADMIN_PASSWORD=E2eCorrectHorse1!
E2E_PROFESSIONAL_EMAIL=pro@studio-a.test
E2E_PROFESSIONAL_PASSWORD=E2eCorrectHorse1!
E2E_RECEPTION_EMAIL=reception@studio-a.test
E2E_RECEPTION_PASSWORD=E2eCorrectHorse1!
E2E_OWNER_B_EMAIL=owner@studio-b.test
