generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MembershipRole {
  OWNER
  ADMIN
  PROFESSIONAL
  RECEPTION
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

enum AuditOutcome {
  SUCCESS
  DENIED
  FAILURE
}

model SystemMetadata {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Tenant {
  id           String           @id @default(cuid())
  slug         String           @unique
  name         String
  isActive     Boolean          @default(true)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  memberships  Membership[]
  sessions     RefreshSession[]
  invitations  Invitation[]
  auditLogs    AuditLog[]

  @@index([isActive])
}

/// Append-only audit trail (CLI-14). No update/delete via app or Postgres triggers.
model AuditLog {
  id                  String          @id @default(cuid())
  tenantId            String
  occurredAt          DateTime        @default(now())
  actorUserId         String?
  actorMembershipId   String?
  actorRole           MembershipRole?
  actorType           String          @default("USER")
  action              String
  entityType          String
  entityId            String?
  outcome             AuditOutcome    @default(SUCCESS)
  requestId           String?
  ipHash              String?
  userAgent           String?
  metadata            Json?
  changes             Json?
  tenant              Tenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([tenantId, occurredAt(sort: Desc)])
  @@index([tenantId, entityType, entityId, occurredAt(sort: Desc)])
  @@index([tenantId, actorUserId, occurredAt(sort: Desc)])
  @@index([tenantId, action, occurredAt(sort: Desc)])
}

/// Entidade GLOBAL (não tenant-owned). Uma pessoa pode pertencer a vários tenants via Membership.
model User {
  id                     String              @id @default(cuid())
  email                  String              @unique // normalizado lower-case na aplicação
  name                   String
  passwordHash           String?
  passwordChangedAt      DateTime?
  emailVerifiedAt        DateTime?
  lastLoginAt            DateTime?
  failedLoginCount       Int                 @default(0)
  lockedUntil            DateTime?
  sessionsInvalidatedAt  DateTime?
  isActive               Boolean             @default(true)
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt
  memberships            Membership[]
  sessions               RefreshSession[]
  resetTokens            PasswordResetToken[]

  @@index([isActive])
}

model Membership {
  id              String         @id @default(cuid())
  tenantId        String
  userId          String
  role            MembershipRole
  isActive        Boolean        @default(true)
  deactivatedAt   DateTime?
  deactivatedById String?
  roleChangedAt   DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  tenant          Tenant         @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId])
  @@index([tenantId, role])
  @@index([tenantId, isActive])
  @@index([userId, isActive])
}

/// Tenant-owned invitation. Partial unique index enforces one PENDING per (tenantId, email).
model Invitation {
  id              String           @id @default(cuid())
  tenantId        String
  email           String
  role            MembershipRole
  tokenHash       String           @unique
  status          InvitationStatus @default(PENDING)
  expiresAt       DateTime
  invitedByUserId String
  acceptedAt      DateTime?
  acceptedUserId  String?
  revokedAt       DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([tenantId, status])
  @@index([tenantId, email, status])
  @@index([expiresAt])
}

model RefreshSession {
  id            String    @id @default(cuid())
  tenantId      String
  userId        String
  familyId      String
  tokenHash     String    @unique
  replacedById  String?   @unique
  expiresAt     DateTime
  revokedAt     DateTime?
  revokedReason String?
  lastUsedAt    DateTime?
  userAgent     String?
  ipHash        String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId, userId, revokedAt])
  @@index([userId, familyId])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, usedAt])
  @@index([expiresAt])
}
